 "assoc": {
  "front_knee_release": "In Worthington's cohort of 20 elite bowlers, front knee angle at release was one of four technique parameters that together explained 73.6% of the variance in release speed.",
  "plant_angle": "Worthington found that braking impulse, rather than peak force, characterised the fastest bowlers in his cohort (r = 0.574), and that they generated it with a larger plant angle."
 },
 "describe": {
  "knee_extension": "Portus et al. (2004) classify front-knee technique by this behaviour: a knee that bends and re-extends before release is a flexor-extender, one that bends and stays bent is a flexor.",
  "foot_strike": "This varies widely between individuals, and the reference bowlers all wore spiked shoes indoors, so footwear and surface shift it.",
  "stride_pct_height": "Measured as Worthington does, ankle to ankle at front foot contact, and converted from torso lengths with an anthropometric constant, so it is approximate.",
  "release_pct_height": "Measured wrist-above-ankle, so it reads roughly 10 cm low against the laboratory definition."
 },
